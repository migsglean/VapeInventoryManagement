@page "/"
@layout LoginLayout

<link href="css/login.css" rel="stylesheet" />

<div class="text-center mb-4">
    <img src="images/store-logo1.png" alt="Logo" class="img mb-3" style="width: 70px;" />
    <h2 class="title fw-bold text-dark">Vape Inventory Management</h2>
</div>

<EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="input mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="loginModel.Email" class="form-control form-control-lg" placeholder="Enter your email" />
    </div>

    <div class="input mb-3">
        <label class="form-label">Password</label>
        <InputText @bind-Value="loginModel.Password" type="password" class="form-control form-control-lg" placeholder="Enter your password" />
    </div>

    <div class="form-check mb-3">
        <InputCheckbox @bind-Value="rememberMe" class="form-check-input" />
        <label class="form-check-label">Remember me</label>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Login</button>

    <div class="foot text-center mt-3">
        <a href="/create-acccount" class="createAccount text-decoration-none text-muted">Create Account</a>
        <a href="/forgot-password" class="text-decoration-none text-muted">Forgot password?</a>
    </div>
</EditForm>